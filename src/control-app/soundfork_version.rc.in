#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@SOUNDFORK_VERSION_REVISION@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@SOUNDFORK_VERSION_REVISION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SoundFork contributors\0"
            VALUE "FileDescription", "SoundFork Control\0"
            VALUE "FileVersion", "@SOUNDFORK_VERSION@\0"
            VALUE "InternalName", "soundfork_control\0"
            VALUE "LegalCopyright", "GPL-3.0-only\0"
            VALUE "OriginalFilename", "soundfork_control.exe\0"
            VALUE "ProductName", "SoundFork\0"
            VALUE "ProductVersion", "@SOUNDFORK_VERSION@\0"
            VALUE "Comments", "SoundFork.ObsPluginManagement/1;SoundFork.StartupManagement/1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
