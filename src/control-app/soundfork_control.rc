#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDI_SOUNDFORK_ICON ICON "../../assets/soundfork.ico"

IDD_UPDATE DIALOGEX 0, 0, 292, 67
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "", -1, 0, 0, 292, 67
    LTEXT "", IDC_UPDATE_VERSION, 9, 9, 274, 12
    PUSHBUTTON "Show changes", IDC_UPDATE_TOGGLE_NOTES, 9, 25, 91, 16
    PUSHBUTTON "Update", IDC_UPDATE_ACTION, 148, 25, 70, 16
    PUSHBUTTON "Later", IDCANCEL, 225, 25, 58, 16
    CONTROL "", IDC_UPDATE_DISABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 9, 47, 274, 12
    LTEXT "", IDC_UPDATE_STATUS, 9, 47, 274, 13, NOT WS_VISIBLE
    CONTROL "", IDC_UPDATE_PROGRESS, "msctls_progress32", NOT WS_VISIBLE | WS_BORDER, 199, 48, 84, 8
END

IDD_UPDATE_NOTES DIALOGEX 0, 0, 350, 204
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Release notes"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_UPDATE_NOTES, "RICHEDIT50W", WS_BORDER | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 12, 12, 326, 151
    PUSHBUTTON "Release page", IDC_UPDATE_RELEASE, 12, 175, 92, 18
    DEFPUSHBUTTON "Close", IDCANCEL, 256, 175, 82, 18
END
