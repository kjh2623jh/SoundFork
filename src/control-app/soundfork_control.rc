#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDI_SOUNDFORK_ICON ICON "../../assets/soundfork.ico"

IDD_UPDATE DIALOGEX 0, 0, 350, 294
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SoundFork update"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_UPDATE_VERSION, 12, 12, 326, 14
    PUSHBUTTON "Show changes", IDC_UPDATE_TOGGLE_NOTES, 12, 31, 98, 17
    CONTROL "", IDC_UPDATE_NOTES, "RICHEDIT50W", NOT WS_VISIBLE | WS_BORDER | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 12, 54, 326, 126
    LTEXT "", IDC_UPDATE_STATUS, 12, 188, 326, 30
    CONTROL "", IDC_UPDATE_PROGRESS, "msctls_progress32", NOT WS_VISIBLE | WS_BORDER, 12, 222, 326, 10
    CONTROL "", IDC_UPDATE_DISABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 237, 326, 12
    PUSHBUTTON "Release page", IDC_UPDATE_RELEASE, 12, 262, 92, 18
    PUSHBUTTON "Update", IDC_UPDATE_ACTION, 140, 262, 108, 18
    DEFPUSHBUTTON "Later", IDCANCEL, 256, 262, 82, 18
END
