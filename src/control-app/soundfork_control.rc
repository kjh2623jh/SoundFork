#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDI_SOUNDFORK_ICON ICON "../../assets/soundfork.ico"

IDD_UPDATE DIALOGEX 0, 0, 350, 294
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SoundFork update"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_UPDATE_VERSION, 12, 12, 326, 14
    LTEXT "Release notes", IDC_UPDATE_NOTES_LABEL, 12, 32, 326, 12
    EDITTEXT IDC_UPDATE_NOTES, 12, 46, 326, 138, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_UPDATE_STATUS, 12, 192, 326, 30
    CONTROL "", IDC_UPDATE_PROGRESS, "msctls_progress32", WS_BORDER, 12, 226, 326, 10
    CONTROL "", IDC_UPDATE_DISABLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 241, 326, 12
    PUSHBUTTON "Release page", IDC_UPDATE_RELEASE, 12, 266, 92, 18
    DEFPUSHBUTTON "Download", IDC_UPDATE_ACTION, 166, 266, 82, 18
    PUSHBUTTON "Later", IDCANCEL, 256, 266, 82, 18
END
