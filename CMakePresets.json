{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc-x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-msvc-x86",
      "displayName": "Windows x86 ASIO components (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows-msvc-x86",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-x86", "configurePreset": "windows-msvc-x86", "configuration": "Debug" },
    { "name": "release-x86", "configurePreset": "windows-msvc-x86", "configuration": "Release" },
    {
      "name": "debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}

