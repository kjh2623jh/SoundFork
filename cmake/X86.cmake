# Only components loaded by a 32-bit ASIO host belong in this build.
if(SOUNDFORK_BUILD_OBS_PLUGIN)
  message(FATAL_ERROR "OBS plugin is x64; build it with windows-msvc-x64")
endif()
target_include_directories(soundfork_host PRIVATE src "${SOUNDFORK_SDK_DIR}")
target_link_libraries(soundfork_host PRIVATE soundfork_bridge soundfork_warnings ole32 advapi32)
add_library(soundfork_app_relay SHARED
  src/capture-backend/app_relay.cpp src/capture-backend/app_relay_x86.def
  src/capture-backend/discord_relay.cpp src/capture-backend/relay_clock.cpp
  src/capture-backend/shared_ring.cpp src/capture-backend/hub_client.cpp)
target_compile_definitions(soundfork_app_relay PRIVATE SOUNDFORK_RELAY_NO_ENTRYPOINT)
target_include_directories(soundfork_app_relay PRIVATE src)
target_link_libraries(soundfork_app_relay PRIVATE soundfork_warnings soundfork_diagnostics ole32 uuid)
add_executable(soundfork_register src/asio-proxy/register_main.cpp)
target_include_directories(soundfork_register PRIVATE src "${SOUNDFORK_SDK_DIR}")
target_link_libraries(soundfork_register PRIVATE soundfork_warnings ole32 advapi32)
add_executable(soundfork_soak_tests tests/soak_tests.cpp)
target_link_libraries(soundfork_soak_tests PRIVATE soundfork_bridge soundfork_fake_backend soundfork_warnings psapi)
if(BUILD_TESTING)
  add_executable(soundfork_registration_tests tests/registration_tests.cpp)
  target_include_directories(soundfork_registration_tests PRIVATE src "${SOUNDFORK_SDK_DIR}")
  target_link_libraries(soundfork_registration_tests PRIVATE soundfork_warnings ole32 advapi32)
  add_dependencies(soundfork_registration_tests soundfork_driver)
  add_test(NAME soundfork_registration_tests COMMAND soundfork_registration_tests)
  add_executable(soundfork_app_relay_tests tests/app_relay_tests.cpp)
  target_link_libraries(soundfork_app_relay_tests PRIVATE soundfork_warnings)
  add_dependencies(soundfork_app_relay_tests soundfork_app_relay)
  add_executable(soundfork_sample_format_tests tests/sample_format_tests.cpp)
  target_include_directories(soundfork_sample_format_tests PRIVATE src)
  target_link_libraries(soundfork_sample_format_tests PRIVATE soundfork_warnings)
  add_test(NAME soundfork_proxy_tests COMMAND soundfork_tests)
  add_test(NAME soundfork_capture_ring_tests COMMAND soundfork_capture_tests)
  add_test(NAME soundfork_com_server_tests COMMAND soundfork_com_tests "$<TARGET_FILE:soundfork_driver>")
  add_test(NAME soundfork_host_list COMMAND soundfork_host --list)
  add_test(NAME soundfork_app_relay_tests COMMAND soundfork_app_relay_tests "$<TARGET_FILE:soundfork_app_relay>")
  add_test(NAME soundfork_sample_format_tests COMMAND soundfork_sample_format_tests)
  add_test(NAME soundfork_soak_ci_tests COMMAND soundfork_soak_tests --seconds 30 --format all)
  set_tests_properties(soundfork_soak_ci_tests PROPERTIES TIMEOUT 60)
endif()
install(TARGETS soundfork_driver soundfork_app_relay soundfork_register soundfork_host
  RUNTIME DESTINATION bin/x86 LIBRARY DESTINATION bin/x86)
